// Freeflow generates this entrypoint in .dart_tool for a debug preview.
import 'dart:convert';
import 'dart:js_interop';
import 'dart:ui' show Brightness;

import 'package:flutter/foundation.dart' show debugBrightnessOverride;
import 'package:flutter/rendering.dart';
import 'package:flutter/widgets.dart';
import 'package:@PACKAGE@/main.dart' as app;

const _origin = String.fromEnvironment('FREEFLOW_WORKBENCH_ORIGIN');
const _libraryUri = @LIBRARY_URI@;

@JS('window')
external _BrowserWindow get _window;

extension type _BrowserWindow(JSObject _) implements JSObject {
  external _BrowserWindow get parent;
  external void postMessage(JSString message, JSString targetOrigin);
  external void addEventListener(
    JSString event,
    JSFunction listener, [
    _EventOptions? options,
  ]);
}

extension type _EventOptions._(JSObject _) implements JSObject {
  external factory _EventOptions({
    required bool passive,
    required bool capture,
  });
}

extension type _BrowserWheel(JSObject _) implements JSObject {
  external bool get ctrlKey;
  external bool get metaKey;
  external double get deltaY;
  external double get clientX;
  external double get clientY;
  external void preventDefault();
  external void stopPropagation();
}

extension type _BrowserMessage(JSObject _) implements JSObject {
  external JSObject? get source;
  external JSString get origin;
  external JSAny? get data;
}

Future<void> main(List<String> args) async {
  final frame = Uri.base.queryParameters['freeflow'] ?? '';
  final Function entrypoint = app.main;
  final result = Function.apply(
    entrypoint,
    entrypoint is Function() ? [] : [args],
  );
  if (result is Future) {
    await result;
  }
  final parent = _window.parent;
  if (_origin.isEmpty || _window.strictEquals(parent).toDart) {
    return;
  }
  final binding = WidgetsBinding.instance;
  final service = WidgetInspectorService.instance;
  final selection = service.selection;
  final ids = Expando<String>();
  var sequence = 0;
  String? previousTree;
  var enabled = false;
  var brightnessRequest = 0;

  void send(Map<String, Object?> message) {
    parent.postMessage(
      jsonEncode({...message, 'frame': frame}).toJS,
      _origin.toJS,
    );
  }

  void ready() => send({'type': 'freeflow:inspector-ready'});

  Map<String, Object?>? location(
    Element element,
    InspectorSerializationDelegate delegate,
  ) {
    if (!debugIsLocalCreationLocation(element)) return null;
    final data = element.toDiagnosticsNode().toJsonMap(delegate);
    final creation = data['creationLocation'];
    if (creation is! Map) return null;
    final file = creation['file'];
    if (file is! String ||
        file.length > 2048 ||
        !(file.startsWith('package:@PACKAGE@/') ||
            file.startsWith('org-dartlang-app:/lib/') ||
            file.startsWith(_libraryUri))) {
      return null;
    }
    final line = creation['line'];
    final column = creation['column'];
    if (line is! int || column is! int) return null;
    return {
      'file': file,
      'line': line,
      'column': column,
      'type': element.widget.runtimeType.toString(),
    };
  }

  void tree(String selected) {
    final root = binding.rootElement;
    if (root == null) return;
    final delegate = InspectorSerializationDelegate(
      service: service,
      subtreeDepth: 0,
    );
    final rows = <Map<String, Object?>>[];
    var visited = 0;
    var truncated = false;
    List<double>? bounds;

    void visit(Element element, String? parent, int depth) {
      if (++visited > 12000 || rows.length >= 350 || depth > 600) {
        truncated = true;
        return;
      }
      final source = location(element, delegate);
      if (source != null) {
        final id = ids[element] ??= (++sequence).toString();
        final widget = element.widget;
        final label = widget is Text
            ? (widget.data ?? widget.textSpan?.toPlainText() ?? '')
            : '';
        rows.add({
          ...source,
          'id': id,
          'parent': parent,
          'label': String.fromCharCodes(label.runes.take(100)),
        });
        parent = id;
        if (id == selected) {
          final render = element.findRenderObject();
          if (render is RenderBox && render.attached && render.hasSize) {
            final rect = MatrixUtils.transformRect(
              render.getTransformTo(null),
              render.paintBounds,
            );
            if (rect.isFinite && !rect.isEmpty) {
              bounds = [rect.left, rect.top, rect.width, rect.height];
            }
          }
        }
      }
      element.visitChildren((child) => visit(child, parent, depth + 1));
    }

    visit(root, null, 0);
    final message = jsonEncode({
      'type': 'freeflow:tree',
      'frame': frame,
      'nodes': rows,
      'truncated': truncated,
      'selected': selected,
      'bounds': bounds,
    });
    if (message != previousTree) {
      previousTree = message;
      parent.postMessage(message.toJS, _origin.toJS);
    }
  }

  selection.addListener(() {
    final element = selection.currentElement;
    if (!enabled || element == null) {
      return;
    }
    final locations = <Map<String, Object?>>[];
    final seen = <String>{};
    final delegate = InspectorSerializationDelegate(service: service);
    String? selected;
    void add(Element element) {
      final source = location(element, delegate);
      if (source != null && seen.add(source.values.join(':'))) {
        selected ??= ids[element];
        locations.add(source);
      }
    }

    add(element);
    element.visitAncestorElements((ancestor) {
      add(ancestor);
      return locations.length < 24;
    });
    send({
      'type': 'freeflow:selection',
      'locations': locations,
      'selected': selected,
    });
  });

  void onMessage(_BrowserMessage event) {
    final source = event.source;
    final data = event.data;
    if (event.origin.toDart != _origin ||
        source == null ||
        !parent.strictEquals(source).toDart ||
        !data.isA<JSString>()) {
      return;
    }
    final action = (data as JSString).toDart;
    if (action.startsWith('freeflow:tree:')) {
      tree(action.substring('freeflow:tree:'.length));
      return;
    }
    if (action.startsWith('freeflow:brightness:')) {
      final mode = action.substring('freeflow:brightness:'.length);
      if (!const ['system', 'light', 'dark'].contains(mode)) return;
      debugBrightnessOverride = switch (mode) {
        'dark' => Brightness.dark,
        'light' => Brightness.light,
        _ => null,
      };
      final request = ++brightnessRequest;
      binding.reassembleApplication().then(
        (_) {
          if (request == brightnessRequest) {
            send({'type': 'freeflow:brightness', 'value': mode});
          }
        },
        onError: (Object error, StackTrace stack) {
          send({'type': 'freeflow:brightness-error'});
        },
      );
      return;
    }
    switch (action) {
      case 'freeflow:hello':
        ready();
      case 'freeflow:inspect-on':
        selection.clear();
        binding.debugWidgetInspectorSelectionOnTapEnabled.value = true;
        enabled = true;
        binding.debugShowWidgetInspectorOverrideNotifier.value = true;
      case 'freeflow:inspect-off':
        enabled = false;
        selection.clear();
        binding.debugShowWidgetInspectorOverrideNotifier.value = false;
    }
  }

  _window.addEventListener('message'.toJS, onMessage.toJS);
  void onWheel(_BrowserWheel event) {
    if ((event.ctrlKey || event.metaKey) &&
        event.deltaY.isFinite &&
        event.deltaY != 0) {
      event.preventDefault();
      event.stopPropagation();
      send({
        'type': 'freeflow:zoom',
        'delta': event.deltaY,
        'x': event.clientX,
        'y': event.clientY,
      });
    }
  }

  _window.addEventListener(
    'wheel'.toJS,
    onWheel.toJS,
    _EventOptions(passive: false, capture: true),
  );
  ready();
}
